# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local and fill in. Every variable here is required unless marked
# optional — the app validates them at startup and refuses to boot without them.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres with the pgvector extension available.
# Neon, Supabase and a local `pgvector/pgvector` container all work.
# `npm run db:migrate` creates the extension itself; the role must own the DB.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>

# ── Auth: Clerk (https://dashboard.clerk.com → API keys) ─────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<your-clerk-publishable-key>
CLERK_SECRET_KEY=<your-clerk-secret-key>

# ── Models: Groq (https://console.groq.com/keys) ─────────────────────────────
# Used for OCR (vision), entity extraction, summaries, chat and transcription.
GROQ_API_KEY=<your-groq-api-key>

# Optional model overrides. Defaults live in src/lib/groq.ts. Set these to pin a
# model without a code change — check https://console.groq.com/docs/models for
# what is currently served, as ids are retired over time.
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# ── Embeddings: Pinecone (https://app.pinecone.io → API keys) ────────────────
# Only the hosted `multilingual-e5-large` embedding endpoint is used — no index
# is created, vectors are stored in Postgres.
PINECONE_API_KEY=<your-pinecone-api-key>

# ── Public URL, used to build shareable record links ─────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Optional: HuggingFace Inference (https://huggingface.co/settings/tokens) ─
# Two features use this:
#   1. the d4data/biomedical-ner-all cross-check pass over extracted text
#      (without it the recognizer falls back to its rule-based patterns only)
#   2. the chest X-ray classifier below
HF_API_KEY=

# ── Optional: chest X-ray screening model ────────────────────────────────────
# Without this, uploaded X-ray IMAGES are not analysed at all — the app reads any
# text on them and says plainly that the image itself was not checked. It never
# falls back to asking a general-purpose LLM to "diagnose" the image, because a
# general VLM cannot do that and will invent plausible findings.
#
# To enable screening, deploy a chest X-ray multi-label classifier as a HuggingFace
# Inference Endpoint and put its URL here. The reference model is
# torchxrayvision/densenet121-res224-all (18 pathologies: effusion, pneumonia,
# pneumothorax, mass, nodule, fracture, infiltration, cardiomegaly, ...).
#
#   https://huggingface.co/torchxrayvision/densenet121-res224-all
#   Deploy -> Inference Endpoints -> copy the endpoint URL
#
# This is a screening/triage aid, NOT a diagnostic device. No openly available
# chest X-ray model is regulator-cleared, they are trained on frontal adult chest
# films, and output is always labelled as needing a doctor's confirmation.
RADIOLOGY_CLASSIFIER_URL=
# RADIOLOGY_CLASSIFIER_MODEL=torchxrayvision/densenet121-res224-all

# ── Where uploaded documents are stored ──────────────────────────────────────
# Two backends. Local disk is the default and is right for development. Object
# storage is required to deploy anywhere serverless (Vercel, Netlify, Cloud Run):
# those filesystems do not persist between invocations, so local disk would lose
# every uploaded document.
#
# Local disk. MUST NOT be inside ./public — anything there is served without auth.
# Defaults to ./.data/uploads (gitignored).
UPLOAD_DIR=

# Object storage — any S3-compatible service. Set all three of BUCKET,
# ACCESS_KEY_ID and SECRET_ACCESS_KEY together, or leave all three empty; a
# half-configured bucket raises at startup rather than silently using local disk.
#
# Cloudflare R2 is the usual choice at small scale: 10GB free and no egress fees,
# which matters when the payload is scans people re-open.
#   R2:        S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto
#   AWS S3:    leave S3_ENDPOINT empty, set S3_REGION (e.g. eu-west-1)
#   Backblaze: S3_ENDPOINT=https://s3.<region>.backblazeb2.com
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_REGION=auto
# Optional key prefix, so one bucket can hold more than this app.
S3_PREFIX=
